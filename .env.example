# Copy to .env and fill in ONE provider. Free tiers: Gemini (aistudio.google.com/apikey), Groq (console.groq.com/keys)
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
# LLM_PROVIDER=huggingface  (token from huggingface.co/settings/tokens, "Inference Providers" permission)
HUGGING_FACE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
