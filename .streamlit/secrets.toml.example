# Copy these keys into your Streamlit Cloud app:
#   App settings -> Secrets -> paste the lines below -> Save.
# Locally, copy this file to .streamlit/secrets.toml (it is gitignored).
# Fill in ONE provider. The app falls back to the offline `mock` provider when no key is set.

GEMINI_API_KEY = ""
# GROQ_API_KEY = ""
# HUGGING_FACE_API_KEY = ""
# OPENAI_API_KEY = ""
# ANTHROPIC_API_KEY = ""

# Optional: pin the provider/model for the sidebar defaults.
# LLM_PROVIDER = "gemini"
# LLM_MODEL = "gemini-3.5-flash"
